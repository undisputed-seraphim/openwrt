#!/bin/sh /etc/rc.common
# Read the vendor NVRAM block once during boot so that the net hotplug
# hook and the wireless setup do not have to wait for the 2 MiB nvdata
# partition when the radios appear.

START=18

boot() {
	/usr/sbin/ap5100w-nvram lanhwaddr >/dev/null 2>&1 || true
	[ -x /usr/sbin/ap5100w-wifi ] && /usr/sbin/ap5100w-wifi
}
