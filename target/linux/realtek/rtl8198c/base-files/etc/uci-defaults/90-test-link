#!/bin/sh

uci set network.lan=interface
# The cable in the test rig is in physical port 4 (netdev eth4).
uci set network.lan.device='eth4'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.2.2'
uci set network.lan.netmask='255.255.255.0'
# The board.d default network is not used by this test config, so take
# the factory LAN MAC from nvdata here as well.
lanmac=$(/usr/sbin/ap5100w-nvram lanhwaddr 2>/dev/null)
[ -n "$lanmac" ] && uci set network.lan.macaddr="$lanmac"
uci commit network

exit 0
