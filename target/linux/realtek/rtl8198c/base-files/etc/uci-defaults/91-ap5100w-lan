#!/bin/sh
# Give br-lan the factory LAN address from the vendor nvdata partition.
#
# config_generate only puts a MAC on a bridge when the "lan" interface
# has one, and it then copies that address onto every bridge port as
# well.  eth3/eth4 have to keep the distinct addresses the switch driver
# assigned, so the factory address is written to the bridge device here
# instead.

lanmac=$(/usr/sbin/ap5100w-nvram lanhwaddr 2>/dev/null)
[ -n "$lanmac" ] || exit 0

sections=$(uci -q show network |
	sed -n "s/^network\.\(@device\[[0-9]*\]\)\.name='br-lan'$/\1/p")
[ -n "$sections" ] || exit 0

for section in $sections; do
	uci -q set "network.$section.macaddr=$lanmac"
done

# A "lan" interface MAC is what makes the generator duplicate the
# address onto the ports; the bridge carries it now.
uci -q delete network.lan.macaddr
uci -q commit network

exit 0
