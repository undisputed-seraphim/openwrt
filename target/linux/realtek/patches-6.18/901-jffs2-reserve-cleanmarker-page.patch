@@ -141,6 +141,15 @@
 
 #endif /* WRITEBUFFER */
 
+/*
+ * The OOB cleanmarker has to be paid for with the first data page when
+ * the NAND controller cannot write the spare area on its own.  Only the
+ * RTL8198C controller has that restriction; everywhere else keep the
+ * upstream accounting.
+ */
+#define jffs2_reserve_cleanmarker_page(c) \
+	(IS_ENABLED(CONFIG_RTL8198C) && jffs2_cleanmarker_oob(c))
+
