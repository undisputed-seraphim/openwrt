--- a/drivers/net/wireless/realtek/rtw88/pci.c
+++ b/drivers/net/wireless/realtek/rtw88/pci.c
@@ -52,15 +52,29 @@
 static u8 rtw_pci_read8(struct rtw_dev *rtwdev, u32 addr)
 {
 	struct rtw_pci *rtwpci = (struct rtw_pci *)rtwdev->priv;
+#if IS_ENABLED(CONFIG_RTL8198C)
+	u32 word_addr = addr & ~3;
+	u32 byte_shift = (addr & 3) << 3;
+	u32 val = readl(rtwpci->mmap + word_addr);
 
+	return (val >> byte_shift) & 0xff;
+#else
 	return readb(rtwpci->mmap + addr);
+#endif
 }
 
 static u16 rtw_pci_read16(struct rtw_dev *rtwdev, u32 addr)
 {
 	struct rtw_pci *rtwpci = (struct rtw_pci *)rtwdev->priv;
+#if IS_ENABLED(CONFIG_RTL8198C)
+	u32 word_addr = addr & ~3;
+	u32 byte_shift = (addr & 3) << 3;
+	u32 val = readl(rtwpci->mmap + word_addr);
 
+	return (val >> byte_shift) & 0xffff;
+#else
 	return readw(rtwpci->mmap + addr);
+#endif
 }
 
 static u32 rtw_pci_read32(struct rtw_dev *rtwdev, u32 addr)
