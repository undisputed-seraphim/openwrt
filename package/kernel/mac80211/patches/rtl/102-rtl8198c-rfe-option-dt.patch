+/*
+ * Some boards populate the RF front end in a way the module efuse does not
+ * describe (the AP5100W uses external PA/LNA on both bands).  Allow the
+ * board device tree to name the RFE option instead.
+ */
+#if IS_ENABLED(CONFIG_OF)
+static void rtw8814a_apply_rfe_override(struct rtw_dev *rtwdev)
+{
+	struct device_node *np = rtwdev->dev->of_node;
+	u8 rfe_option;
+
+	if (!np)
+		np = of_root;
+	if (!np)
+		return;
+
+	if (!of_property_read_u8(np, "realtek,wifi-rfe-option", &rfe_option))
+		rtwdev->efuse.rfe_option = rfe_option;
+}
+#else
+static void rtw8814a_apply_rfe_override(struct rtw_dev *rtwdev)
+{
+}
+#endif
+
 static int rtw8814a_read_efuse(struct rtw_dev *rtwdev, u8 *log_map)
